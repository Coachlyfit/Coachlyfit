# Copy to .env.test.local and fill in with `supabase start`'s local values
# (`supabase status` prints them). Overrides .env.local's Supabase vars for
# `npm test` only, so tests/rls/** never touches the hosted project.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
